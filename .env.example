# 复制为 .env.local 后填入实际值（.env.local 已被 .gitignore 忽略，不会提交）

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 供 /api/interpret（单盘解读）与 /api/heming（合盘分析）使用。
#
# 不填也能用：排盘、命盘展示、古籍阅读、知识库全部在浏览器端完成，不需要密钥。
# 只是点「命格 / 感情 / 事业」这些解读按钮时会提示「模型未配置」。

# 可选值：deepseek（默认）| gemini | openai | custom
AI_PROVIDER=deepseek

# DeepSeek（国内直连，推荐）
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 换别家：取消注释并同步改上面的 AI_PROVIDER ───
# Gemini（需要能访问 generativelanguage.googleapis.com）
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key

# OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key

# ─── 自建 / 中转网关（任何 OpenAI 兼容服务）───
# AI_PROVIDER=custom
# AI_BASE_URL=https://your-gateway/v1
# AI_MODEL=your-model-name
# AI_API_KEY=your-key

# ─── 通用覆盖（优先级最高，接私有网关时用）───
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 合盘报告购买 ───
# DATABASE_URL=postgresql://user:password@localhost:5432/ziwei
# 首次建表：node scripts/migrate-commerce.mjs
# COMMERCE_ENABLED=0
# 可在运行时单独指定同一个 HTTPS 站点地址。
# COMMERCE_SITE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# WAFFO_ENVIRONMENT=test
# WAFFO_MERCHANT_ID=
# WAFFO_PRIVATE_KEY=
# WAFFO_WEBHOOK_PUBLIC_KEY=
# WAFFO_STORE_ID=STO_...
# WAFFO_PRODUCT_ID=PROD_...
# WAFFO_TAX_CATEGORY=digital_goods
# COMMERCE_SUPPORT_EMAIL=
# COMMERCE_ADMIN_EMAILS=
# 实际扣款须单独打开，并使用获准经营该业务的商户账户。
# COMMERCE_LIVE_PAYMENTS=0
# 仅开发环境的回环地址可用。本地测试账号、模拟付款和样例报告均不会访问外部服务。
# COMMERCE_LOCAL_TEST=1
# COMMERCE_LOCAL_USE_MODEL=0

# ─── 解读数据集（可选，但强烈建议开）───
# 开启后，解读会先按命盘键查出断语库已校对好的原文（事实底座），再让模型转述与追问；
# 不配置时退回纯引擎 + prompt，功能正常，但断语的准确度完全取决于模型。
#
# 数据集来自 Release v4.0-13d（77 个 year-YYYY.jsonl），解压到任意目录后指向它：
# ZIWEI_DATASET_DIR=G:\紫微斗数解读参数集
#
# 索引目录（scripts/build-dataset-index.ts 的产出），默认 <项目>/.workbuddy/cache/dataset-index
# ZIWEI_DATASET_INDEX=
# 付费合盘使用明确配置且已确认可商用的语料时开启。
# COMMERCE_HEMING_DATASET=0
